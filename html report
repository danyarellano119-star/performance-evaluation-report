    <option value="0-3.49">< 3.5 (Atención requerida)</option>
  </select>

  <button class="btn-reset" id="btn-reset">✕ Limpiar filtros</button>
  <span class="result-count" id="result-count">Mostrando 95 de 95</span>
</div>

<div class="main">

  <!-- KPIs -->
  <div class="kpi-grid">
    <div class="kpi kpi-accent">
      <div class="kpi-label">Promedio general</div>
      <div class="kpi-value" id="kpi-avg">4.11</div>
      <div class="kpi-sub">Escala 0 – 5</div>
    </div>
    <div class="kpi kpi-accent">
      <div class="kpi-label">Colaboradores</div>
      <div class="kpi-value" id="kpi-total">95</div>
      <div class="kpi-sub">Evaluados este semestre</div>
    </div>
    <div class="kpi kpi-accent">
      <div class="kpi-label">Desempeño extraordinario</div>
      <div class="kpi-value" id="kpi-ext">11</div>
      <div class="kpi-sub">Calificación ≥ 4.5</div>
    </div>
    <div class="kpi kpi-accent">
      <div class="kpi-label">Requieren atención</div>
      <div class="kpi-value" id="kpi-low">2</div>
      <div class="kpi-sub">Calificación < 3.5</div>
    </div>
  </div>

  <!-- Fila 1: competencias + donut -->
  <div class="chart-row chart-row-2" style="grid-template-columns: 1.6fr 1fr;">
    <div class="card">
      <div class="card-title">Promedio por competencia</div>
      <div class="chart-wrap" style="height:280px;"><canvas id="catChart"></canvas></div>
    </div>
    <div class="card">
      <div class="card-title">Distribución de niveles</div>
      <div class="legend" id="donut-legend"></div>
      <div class="chart-wrap" style="height:230px;"><canvas id="donutChart"></canvas></div>
    </div>
  </div>

  <!-- Fila 2: por área + por evaluador -->
  <div class="chart-row chart-row-2">
    <div class="card">
      <div class="card-title">Promedio por dirección</div>
      <div class="chart-wrap" style="height:220px;"><canvas id="deptChart"></canvas></div>
    </div>
    <div class="card">
      <div class="card-title">Comparación top 10 vs foco de mejora</div>
      <div class="chart-wrap" style="height:220px;"><canvas id="scatter-chart"></canvas></div>
    </div>
  </div>

  <!-- Tabla -->
  <div class="card">
    <div class="card-title">Detalle por colaborador</div>
    <div class="table-wrap">
      <table id="main-table">
        <thead>
          <tr>
            <th data-col="evaluado">Colaborador <span class="sort-arrow">↕</span></th>
            <th data-col="cargo">Cargo <span class="sort-arrow">↕</span></th>
            <th data-col="dept">Área <span class="sort-arrow">↕</span></th>
            <th data-col="score" class="active">Puntaje <span class="sort-arrow">↓</span></th>
            <th data-col="n_eval"># Eval. <span class="sort-arrow">↕</span></th>
            <th data-col="nivel">Nivel <span class="sort-arrow">↕</span></th>
          </tr>
        </thead>
        <tbody id="table-body"></tbody>
      </table>
    </div>
    <div class="pagination">
      <span class="page-info" id="page-info"></span>
      <div class="page-btns" id="page-btns"></div>
    </div>
  </div>

</div>

