const CAT_KEYS = ['sc_Productividad','sc_Eficiencia','sc_Organización','sc_Aprendizaje','sc_Rel. Interpersonales','sc_Liderazgo','sc_Orient. Servicio','sc_Comunicación','sc_Trabajo en Equipo','sc_Orient. Resultados','sc_Creatividad'];
const CAT_LABELS = ['Productividad','Eficiencia','Organización','Aprendizaje','Rel. Interpersonales','Liderazgo','Orient. Servicio','Comunicación','Trabajo en Equipo','Orient. Resultados','Creatividad'];
const DEPT_LIST = ['Construcción','Administrativa','Técnico-Admin','Urbanismo','Contable','Comercial/Financiera'];

const BLUE = '#1a56a5', BLUE2 = '#3d8bcd', BLUE3 = '#85B7EB', BLUE4 = '#B5D4F4';
const NIV_COLORS = {'Extraordinario': '#1a56a5','Buen desempeño':'#2a7a40','Alcanza mínimos':'#b45309','Necesita mejorar':'#b91c1c'};

let filtered = [...RAW];
let sortCol = 'score', sortDir = -1;
let currentPage = 1;
const PER_PAGE = 15;

let catChart, donutChart, deptChart, scatterChartObj;

function scoreClass(s) {
  if (s >= 4.5) return 'score-high';
  if (s >= 3.5) return 'score-med';
  if (s >= 2.5) return 'score-low';
  return 'score-bad';
}
function nivelClass(n) {
  if (n === 'Extraordinario') return 'nivel-ext';
  if (n === 'Buen desempeño') return 'nivel-bien';
  if (n === 'Alcanza mínimos') return 'nivel-min';
  return 'nivel-mej';
}

function applyFilters() {
  const dept = document.getElementById('filter-dept').value;
  const nivel = document.getElementById('filter-nivel').value;
  const scoreRange = document.getElementById('filter-score').value;
  const search = document.getElementById('search-name').value.trim().toLowerCase();

  filtered = RAW.filter(r => {
    if (dept && r.dept !== dept) return false;
    if (nivel && r.nivel !== nivel) return false;
    if (search && !r.evaluado.toLowerCase().includes(search)) return false;
    if (scoreRange) {
      const [lo, hi] = scoreRange.split('-').map(Number);
      if (r.score < lo || r.score > hi) return false;
    }
    return true;
  });

  currentPage = 1;
  updateAll();
}

function updateAll() {
  updateKPIs();
  updateCharts();
  renderTable();
  document.getElementById('result-count').textContent = `Mostrando ${filtered.length} de ${RAW.length}`;
  document.getElementById('badge-count').textContent = `${filtered.length} colaboradores`;
}

function updateKPIs() {
  const avg = filtered.length ? (filtered.reduce((s,r) => s+r.score, 0)/filtered.length).toFixed(2) : '—';
  const ext = filtered.filter(r => r.score >= 4.5).length;
  const low = filtered.filter(r => r.score < 3.5).length;
  document.getElementById('kpi-avg').textContent = avg;
  document.getElementById('kpi-total').textContent = filtered.length;
  document.getElementById('kpi-ext').textContent = ext;
  document.getElementById('kpi-low').textContent = low;
}

function updateCharts() {
  // --- Category chart ---
  const catAvgs = CAT_KEYS.map(k => {
    const vals = filtered.filter(r => r[k] != null).map(r => r[k]);
    return vals.length ? +(vals.reduce((a,b)=>a+b,0)/vals.length).toFixed(2) : 0;
  });

  if (catChart) {
    catChart.data.datasets[0].data = catAvgs;
    catChart.data.datasets[0].backgroundColor = catAvgs.map(v => v >= 4.15 ? BLUE : v >= 4.05 ? BLUE2 : BLUE3);
    catChart.update();
  } else {
    catChart = new Chart(document.getElementById('catChart'), {
      type: 'bar',
      data: { labels: CAT_LABELS, datasets: [{ data: catAvgs, backgroundColor: catAvgs.map(v => v>=4.15?BLUE:v>=4.05?BLUE2:BLUE3), borderRadius: 4, barThickness: 16 }] },
      options: { indexAxis:'y', responsive:true, maintainAspectRatio:false, plugins:{legend:{display:false}, tooltip:{callbacks:{label:c=>' '+c.raw.toFixed(2)+' / 5'}}}, scales:{x:{min:3.5,max:5,ticks:{font:{size:11}},grid:{color:'rgba(0,0,0,0.04)'}},y:{ticks:{font:{size:11}},grid:{display:false}}} }
    });
  }

  // --- Donut chart ---
  const nCounts = {};
  filtered.forEach(r => nCounts[r.nivel] = (nCounts[r.nivel]||0)+1);
  const nLabels = Object.keys(nCounts);
  const nData = nLabels.map(k => nCounts[k]);
  const nColors = nLabels.map(k => NIV_COLORS[k] || '#aaa');

  const legend = document.getElementById('donut-legend');
  legend.innerHTML = nLabels.map((l,i) => `<span class="legend-item"><span class="legend-dot" style="background:${nColors[i]}"></span>${l} (${nData[i]})</span>`).join('');

  if (donutChart) {
    donutChart.data.labels = nLabels;
    donutChart.data.datasets[0].data = nData;
    donutChart.data.datasets[0].backgroundColor = nColors;
    donutChart.update();
  } else {
    donutChart = new Chart(document.getElementById('donutChart'), {
      type: 'doughnut',
      data: { labels: nLabels, datasets: [{ data: nData, backgroundColor: nColors, borderWidth: 0, hoverOffset:6 }] },
      options: { responsive:true, maintainAspectRatio:false, cutout:'65%', plugins:{legend:{display:false}, tooltip:{callbacks:{label:c=>' '+c.label+': '+c.raw}}} }
    });
  }

  // --- Dept chart ---
  const deptAvgs = DEPT_LIST.map(d => {
    const rows = filtered.filter(r => r.dept === d);
    return rows.length ? +(rows.reduce((s,r)=>s+r.score,0)/rows.length).toFixed(2) : null;
  });
  const deptColors = deptAvgs.map(v => v === null ? '#eee' : v>=4.1?BLUE:v>=3.9?BLUE2:BLUE3);

  if (deptChart) {
    deptChart.data.datasets[0].data = deptAvgs;
    deptChart.data.datasets[0].backgroundColor = deptColors;
    deptChart.update();
  } else {
    deptChart = new Chart(document.getElementById('deptChart'), {
      type: 'bar',
      data: { labels: DEPT_LIST, datasets: [{ data: deptAvgs, backgroundColor: deptColors, borderRadius:4 }] },
      options: { responsive:true, maintainAspectRatio:false, plugins:{legend:{display:false}, tooltip:{callbacks:{label:c=>c.raw!=null?' '+c.raw.toFixed(2)+' / 5':'Sin datos'}}}, scales:{x:{ticks:{font:{size:10},maxRotation:25},grid:{display:false}},y:{min:3.0,max:5,ticks:{font:{size:11}},grid:{color:'rgba(0,0,0,0.04)'}}} }
    });
  }

  // --- Scatter: n_eval vs score ---
  const scData = filtered.map(r => ({x: r.n_eval, y: r.score, label: r.evaluado}));
  if (scatterChartObj) {
    scatterChartObj.data.datasets[0].data = scData;
    scatterChartObj.update();
  } else {
    scatterChartObj = new Chart(document.getElementById('scatter-chart'), {
      type: 'scatter',
      data: { datasets: [{ data: scData, backgroundColor: BLUE+'99', borderColor: BLUE, pointRadius: 5, pointHoverRadius: 7 }] },
      options: { responsive:true, maintainAspectRatio:false, plugins:{legend:{display:false}, tooltip:{callbacks:{label:c=>c.raw.label+': '+c.raw.y.toFixed(2)}}}, scales:{x:{title:{display:true,text:'N° de evaluaciones',font:{size:11}},ticks:{font:{size:11}},grid:{color:'rgba(0,0,0,0.04)'}},y:{min:2.5,max:5.2,title:{display:true,text:'Puntaje',font:{size:11}},ticks:{font:{size:11}},grid:{color:'rgba(0,0,0,0.04)'}}} }
    });
  }
}

function sortData() {
  filtered.sort((a,b) => {
    let av = a[sortCol], bv = b[sortCol];
    if (typeof av === 'string') av = av.toLowerCase(), bv = bv.toLowerCase();
    return av < bv ? sortDir : av > bv ? -sortDir : 0;
  });
}

function renderTable() {
  sortData();
  const start = (currentPage-1)*PER_PAGE;
  const page = filtered.slice(start, start+PER_PAGE);
  const tbody = document.getElementById('table-body');
  tbody.innerHTML = page.map(r => `
    <tr>
      <td style="font-weight:500;">${r.evaluado}</td>
      <td style="color:#555;font-size:12px;">${r.cargo}</td>
      <td><span style="font-size:11px;background:#e6f1fb;color:#0c447c;padding:2px 8px;border-radius:12px;">${r.dept}</span></td>
      <td><span class="score-pill ${scoreClass(r.score)}">${r.score.toFixed(2)}</span></td>
      <td style="text-align:center;color:#888;">${r.n_eval}</td>
      <td><span class="nivel-badge ${nivelClass(r.nivel)}">${r.nivel}</span></td>
    </tr>`).join('');
  renderPagination();
}

function renderPagination() {
  const total = Math.ceil(filtered.length / PER_PAGE);
  const start = (currentPage-1)*PER_PAGE+1;
  const end = Math.min(currentPage*PER_PAGE, filtered.length);
  document.getElementById('page-info').textContent = filtered.length ? `${start}–${end} de ${filtered.length}` : '0 resultados';

  const btns = document.getElementById('page-btns');
  let html = `<button class="page-btn" onclick="goPage(${currentPage-1})" ${currentPage===1?'disabled':''}>‹</button>`;
  for (let p=1; p<=total; p++) {
    if (total <= 7 || Math.abs(p-currentPage)<=1 || p===1 || p===total) {
      html += `<button class="page-btn ${p===currentPage?'active':''}" onclick="goPage(${p})">${p}</button>`;
    } else if (Math.abs(p-currentPage)===2) {
      html += `<button class="page-btn" disabled>…</button>`;
    }
  }
  html += `<button class="page-btn" onclick="goPage(${currentPage+1})" ${currentPage===total||total===0?'disabled':''}>›</button>`;
  btns.innerHTML = html;
}

function goPage(p) {
  const total = Math.ceil(filtered.length/PER_PAGE);
  if (p < 1 || p > total) return;
  currentPage = p;
  renderTable();
}

// Sort click
document.querySelectorAll('thead th[data-col]').forEach(th => {
  th.addEventListener('click', () => {
    const col = th.dataset.col;
    if (sortCol === col) sortDir *= -1;
    else { sortCol = col; sortDir = -1; }
    document.querySelectorAll('thead th').forEach(t => { t.classList.remove('active'); t.querySelector('.sort-arrow').textContent = '↕'; });
    th.classList.add('active');
    th.querySelector('.sort-arrow').textContent = sortDir === -1 ? '↓' : '↑';
    renderTable();
  });
});

// Filter events
['filter-dept','filter-nivel','filter-score'].forEach(id => document.getElementById(id).addEventListener('change', applyFilters));
document.getElementById('search-name').addEventListener('input', applyFilters);
document.getElementById('btn-reset').addEventListener('click', () => {
  ['filter-dept','filter-nivel','filter-score'].forEach(id => document.getElementById(id).value='');
  document.getElementById('search-name').value = '';
  applyFilters();
});

// Init
updateAll();
</script>
