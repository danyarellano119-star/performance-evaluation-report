<div class="topbar">
  <div class="topbar-left">
    <span class="logo">MORROS</span>
    <span class="topbar-title">Valoración de Desempeño · Semestre 2025-02</span>
  </div>
  <span class="topbar-badge" id="badge-count">95 colaboradores</span>
</div>

<div class="filterbar">
  <span class="filter-label">Filtrar por:</span>

  <div class="search-wrap">
    <span class="search-icon">🔍</span>
    <input type="text" class="search-input" id="search-name" placeholder="Buscar colaborador...">
  </div>

  <div class="filter-sep"></div>

  <select class="filter-select" id="filter-dept">
    <option value="">Todas las áreas</option>
    <option>Construcción</option>
    <option>Administrativa</option>
    <option>Técnico-Admin</option>
    <option>Urbanismo</option>
    <option>Contable</option>
    <option>Comercial/Financiera</option>
  </select>

  <select class="filter-select" id="filter-nivel">
